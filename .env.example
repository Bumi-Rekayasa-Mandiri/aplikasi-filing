APP_NAME="Filing System BRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=        
DB_USERNAME=        
DB_PASSWORD=        


SESSION_DRIVER=file         
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public      
QUEUE_CONNECTION=sync       
MEDIA_DISK=public

CACHE_STORE=file            

# ==============================
# MAIL — isi sesuai Hostinger
# ==============================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=              
MAIL_PASSWORD=              
MAIL_FROM_ADDRESS=          
MAIL_FROM_NAME="${APP_NAME}"

IMAGE_DRIVER=gd

VITE_APP_NAME="${APP_NAME}"